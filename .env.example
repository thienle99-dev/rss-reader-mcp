RSS_MCP_HOST=0.0.0.0
RSS_MCP_PORT=8080
RSS_MCP_PATH=/mcp
RSS_DB_PATH=/data/rss.db
RSS_REFRESH_ENABLED=true
RSS_REFRESH_INTERVAL=30m
RSS_FETCH_TIMEOUT=10s
RSS_MAX_FEED_BYTES=2097152
RSS_MAX_CONTENT_BYTES=65536
RSS_MAX_CONCURRENT_FETCHES=3
RSS_MAX_FEEDS=200
RSS_ARTICLE_RETENTION_DAYS=90
RSS_LOG_LEVEL=info
RSS_HTTP_USER_AGENT=RSSReaderMCP/1.0
RSS_MCP_AUTH_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
RSS_URL_ALLOWLIST=
# Comma-separated allowed Origin hostnames; empty rejects browser Origin headers.
RSS_MCP_ALLOWED_HOSTS=
RSS_MAX_ARTICLES_PER_RESPONSE=100
RSS_MCP_MAX_REQUEST_BYTES=1048576
RSS_MCP_HTTP_TIMEOUT=2m
RSS_FETCH_RETRY_ATTEMPTS=3
